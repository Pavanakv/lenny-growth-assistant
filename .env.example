# ==============================================================================
# Lenny Growth Assistant - Environment Configuration
# Copy this file to .env and fill in the values you need.
# Safe defaults are provided so the app runs fully local (Ollama + local Postgres)
# with zero paid API keys.
# ==============================================================================

# ---- Database (required) ----
# Default matches the `db` service in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant
# Used by scripts run outside docker (e.g. local ingestion against a docker DB)
DATABASE_URL_LOCAL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# ---- LLM Provider Toggle (required) ----
# One of: ollama | anthropic
# Ollama is mandatory for the graded demo and is the default so the app works
# with zero cloud credentials.
DEFAULT_LLM_PROVIDER=ollama

# ---- Ollama (local, required for demo) ----
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Anthropic (cloud, optional) ----
# Leave blank to disable. If DEFAULT_LLM_PROVIDER=anthropic and this is blank,
# the app falls back to Ollama and logs a warning (see providers/factory.py).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- App / API ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---- Retrieval ----
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.35
CHUNK_TOKEN_SIZE=650
CHUNK_TOKEN_OVERLAP=100

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
